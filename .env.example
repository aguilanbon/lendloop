# ─────────────────────────────────────────────────────────────────────────────
# Next.js app (.env.local). `npx convex dev` writes the CONVEX_* lines for you.
# ─────────────────────────────────────────────────────────────────────────────
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=

# Clerk dashboard → API keys.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# Convex deployment env vars. NOT read from this file: set them with
#   npx convex env set NAME value
# ─────────────────────────────────────────────────────────────────────────────
# CLERK_JWT_ISSUER_DOMAIN=https://your-instance.clerk.accounts.dev
# N8N_LOAN_EVENTS_WEBHOOK_URL=http://localhost:5678/webhook/lendloop/loan-events
# CONVEX_TO_N8N_SECRET=<openssl rand -hex 32>   signs Convex → n8n webhooks
# N8N_TO_CONVEX_SECRET=<openssl rand -hex 32>   verifies n8n → Convex calls

# ─────────────────────────────────────────────────────────────────────────────
# n8n (.env.n8n for docker compose, or your shell when running `npx n8n`).
# The two secrets must match the Convex ones above.
# ─────────────────────────────────────────────────────────────────────────────
# LENDLOOP_CONVEX_SITE_URL=http://host.docker.internal:3211   (local Convex) or https://<name>.convex.site
# CONVEX_TO_N8N_SECRET=
# N8N_TO_CONVEX_SECRET=
# N8N_ENCRYPTION_KEY=<openssl rand -hex 32>   encrypts n8n's stored credentials
