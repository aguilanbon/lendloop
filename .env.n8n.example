# Copy to .env (next to docker-compose.yml). Never commit the real file.

# Where n8n reaches Convex HTTP actions:
#   local Convex (npx convex dev, local deployment):  http://host.docker.internal:3211
#   Convex cloud:                                      https://<deployment>.convex.site
LENDLOOP_CONVEX_SITE_URL=http://host.docker.internal:3211

# Must match the values set in Convex with `npx convex env set`.
# Generate each with: openssl rand -hex 32
CONVEX_TO_N8N_SECRET=
N8N_TO_CONVEX_SECRET=

# Encrypts credentials stored in n8n. Generate once and keep it.
N8N_ENCRYPTION_KEY=

GENERIC_TIMEZONE=UTC
